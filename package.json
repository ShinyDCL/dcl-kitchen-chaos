{
  "name": "dcl-project",
  "version": "1.0.0",
  "description": "SDK7 Template scene",
  "scripts": {
    "start": "sdk-commands start",
    "predeploy": "node scripts/stamp-build.mjs && npm run build",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "upgrade-sdk": "npm install --save-dev --save-exact @dcl/sdk@auth-server @dcl/js-runtime@auth-server",
    "server-logs": "sdk-commands scene-insights tail"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.32.1-41691874543.commit-3063788",
    "@dcl/sdk": "7.32.1-41691874543.commit-3063788"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "proseWrap": "always",
    "trailingComma": "none"
  }
}